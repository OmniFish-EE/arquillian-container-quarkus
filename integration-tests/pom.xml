<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian</groupId>
        <artifactId>quarkus-containers-main</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>quarkus-integration-tests</artifactId>
    <packaging>pom</packaging>

    <name>Arquillian Container for Quarkus - Integration Tests</name>

    <properties>
        <!-- The tests are not published -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>helloworld-jvm</module>
        <module>helloworld-war-jvm</module>
        <module>helloworld-faces-jvm</module>
    </modules>

    <profiles>
        <!-- The native tests need GraalVM and take a native build per test: mvn install -Dnative -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <modules>
                <module>helloworld-native</module>
                <module>helloworld-war-native</module>
                <module>helloworld-faces-native</module>
            </modules>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>ee.omnifish.arquillian</groupId>
            <artifactId>arquillian-quarkus-managed</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
